{
  "name": "anirudh-portfolio",
  "version": "9.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "vitest run --dir tests/unit",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test:output": "vitest run --dir tests/output",
    "validate:content": "tsx scripts/validate-content.ts",
    "check:build": "node scripts/check-build.mjs",
    "verify": "npm run check && npm test && npm run validate:content && npm run build && npm run test:output && npm run check:build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.4",
    "cheerio": "1.2.0",
    "file-type": "22.1.1",
    "gray-matter": "4.0.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
