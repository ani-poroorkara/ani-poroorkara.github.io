---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeSections from '../components/ResumeSections.astro';
import { site, resume } from '../lib/data';
const hasFacts = resume.experience.length || resume.education.length || resume.skills.length;
---
<BaseLayout title="Résumé — Anirudh Poroorkara" description="Experience, education, and skills of Anirudh Poroorkara." canonicalPath="/resume/">
  <section class="page-intro"><p class="eyebrow">Background & experience</p><h1>Résumé<span class="accent">.</span></h1><p class="intro">{site.name}</p>{resume.pdf && <a class="button" href={resume.pdf} download>Download PDF ↓</a>}</section>
  <div class="resume-content"><ResumeSections {resume} />{!hasFacts && <div class="empty-state"><h2>A current résumé is on its way.</h2><p>For background and experience, feel free to get in touch.</p><a class="text-link" href={`mailto:${site.contactEmail}`}>Request my résumé ↗</a></div>}</div>
</BaseLayout>
