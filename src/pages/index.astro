---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../lib/data';
import { getPublicProjects, getPublicPosts } from '../lib/content/queries';
const projects = (await getPublicProjects()).filter(entry => entry.data.featured).slice(0, 3);
const posts = (await getPublicPosts()).slice(0, 3);
---
<BaseLayout title="Anirudh Poroorkara — AI-first thinking" description={site.seoDescription} canonicalPath="/">
  <section class="hero" id="landing">
    <div class="hero-copy"><h1>Anirudh<br /><span class="serif">Poroorkara</span></h1><p class="hero-description">{site.headline} I build, experiment, and share what I learn along the way.</p><div class="hero-actions"><a class="button" href="#projects">Explore my work <span aria-hidden="true">↗</span></a><a class="text-link" href="/blog/">Read my notes →</a></div><div class="hero-footnote"><span>AI & machine learning</span><span>Software</span><span>Curiosity</span></div></div>
    <div class="hero-illustration"><div class="hero-visual" aria-hidden="true"><div class="visual-grid"></div><div class="signal signal-a"></div><div class="signal signal-b"></div><div class="signal signal-c"></div><div class="signal signal-d"></div><div class="clarity-node"><span>many possibilities</span><strong>one clear path<span>↗</span></strong><div class="node-lines"><i></i><i></i><i></i></div><small>think · build · simplify</small></div></div></div>
  </section>
  <section class="section writing-section"><div class="section-heading"><div><p class="eyebrow">01 / Writing</p><h2>Notes<span class="accent">.</span></h2></div><a class="text-link" href="/blog/">All writing ↗</a></div>{posts.length ? <div class="post-list">{posts.map(entry => <PostCard {entry} />)}</div> : <div class="writing-empty"><span class="note-symbol" aria-hidden="true">✳</span><div><h3>A few thoughts are taking shape.</h3><p>Notes on AI, building software, and making things simpler. Coming soon.</p></div><a class="text-link" href="/blog/">Visit the blog →</a></div>}</section>
  <section class="about-section section" id="about" aria-labelledby="about-heading">
    <p class="eyebrow about-label">02 / About</p>
    <div class="about-content">
      <div class="about-copy">
        <h2 id="about-heading">A bit <span class="serif">about me.</span></h2>
        <p class="intro">I explore AI and build software. I enjoy figuring out how things work, trying out ideas, and making something useful.</p>
        <p class="muted">Away from the screen, it’s cooking, movies, and art. Usually with something new to learn along the way.</p>
        <a class="text-link about-link" href="/resume/">My background <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="about-quote">
        <div class="quote-portrait"><img class="sun-tzu-portrait" src="/brand/sun-tzu.svg" alt="Imagined illustration of Sun Tzu" width="240" height="280" loading="lazy" /><span class="quote-mark" aria-hidden="true">“</span></div>
        <blockquote><p>If you know the enemy and know yourself,<br /><span class="serif">you need not fear the result of a hundred battles.</span></p></blockquote>
        <figcaption><span>Sun Tzu</span><a class="quote-note" href="https://www.gutenberg.org/files/17405/17405-h/17405-h.htm#chap03">The Art of War · III</a></figcaption>
      </figure>
    </div>
  </section>
  <section class="contact-section" id="contact"><p class="eyebrow">Have an interesting problem?</p><h2>Let’s think it through<span class="serif">.</span></h2><p>{site.availability}</p><a class="button" href={`mailto:${site.contactEmail}`}>Say hello <span aria-hidden="true">↗</span></a></section>
  <section class="work-section section" id="projects"><div class="section-heading"><div><p class="eyebrow">03 / Selected work</p><h2>Ideas, made tangible<span class="accent">.</span></h2></div><a class="text-link" href="/projects/">All projects ↗</a></div><div class="project-grid">{projects.map((entry, index) => <ProjectCard {entry} {index} />)}</div>{!projects.length && <p class="empty-state">Selected projects are on their way.</p>}</section>
</BaseLayout>
