---
import { render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublicPosts } from '../../lib/content/queries';
export async function getStaticPaths() { return (await getPublicPosts()).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'blog'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ArticleLayout title={entry.data.title} description={entry.data.summary} canonicalPath={`/blog/${entry.id}/`} published={entry.data.published} updated={entry.data.updated} image={entry.data.cover}>
  {entry.data.cover && <img src={entry.data.cover} alt={entry.data.coverAlt} width="1200" height="750" />}<Content />
</ArticleLayout>
