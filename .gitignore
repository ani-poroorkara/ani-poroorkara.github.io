# Node
node_modules/

# Build outputs
/dist/
/build/
/.output/
/.vite/
/node_modules/.vite/

# Vite cache
.vite

# Environment variables - do NOT commit secrets. Keep an example file instead (e.g. .env.example)
.env
.env.local
.env.*.local
.env.test
.env.production.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# TypeScript
*.tsbuildinfo

# Cache, temp
.cache/
.tmp/
.temp/
.sass-cache/

# Testing
/coverage/
.jest/

# ESLint
.eslintcache

# Parcel / Turborepo / other tool caches
.parcel-cache/
.turbo/
.pnpm-store/

# Misc
*.tgz
*.zip

# Optional: lockfiles are typically committed for reproducible installs - do not ignore package-lock.json or pnpm-lock.yaml by default

# IDE-specific
*.iml

# Docker
*.local.env

# Ensure sensitive or large files aren't accidentally added
.DS_Store
*.pem
*.key

# macOS Finder attributes
Icon?

# Windows image file cache
Thumbs.db

# End of gitignore
